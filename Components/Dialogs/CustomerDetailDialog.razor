@inject ApiClient Api
@inject ISnackbar Snack
<MudDialog>
    <DialogContent>
        @if (_loading) { <MudProgressLinear Indeterminate="true" /> }
        else
        {
            <StatStrip Row="_summary" Max="8" />

            <MudPaper Elevation="0" Class="uf-card pa-3 mb-3">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Adjust balance</MudText>
                <MudGrid Spacing="2" AlignItems="Center">
                    <MudItem xs="12" sm="4"><MudNumericField T="decimal" @bind-Value="_adj" Label="Amount (+ debt / − credit)" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" sm="5"><MudTextField @bind-Value="_reason" Label="Reason" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" sm="3"><MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" OnClick="Adjust">Apply</MudButton></MudItem>
                </MudGrid>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ToggleStatus">Activate / deactivate</MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Warning" OnClick="ResetPwd">Reset password</MudButton>
                </div>
            </MudPaper>

            <MudTabs Elevation="0" Rounded="true" PanelClass="pt-3">
                <MudTabPanel Text="Bills"><MiniTable Rows="_bills" Cols="_billCols" /></MudTabPanel>
                <MudTabPanel Text="Payments"><MiniTable Rows="_pays" Cols="_payCols" /></MudTabPanel>
                <MudTabPanel Text="Fines"><MiniTable Rows="_fines" Cols="_fineCols" /></MudTabPanel>
                <MudTabPanel Text="Contributions"><MiniTable Rows="_contribs" Cols="_contribCols" /></MudTabPanel>
            </MudTabs>
        }
    </DialogContent>
    <DialogActions><MudButton OnClick="Close">Close</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int CustomerId { get; set; }
    JsonRow? _summary; List<JsonRow> _bills = new(), _pays = new(), _fines = new(), _contribs = new();
    bool _loading = true, _changed; decimal _adj; string _reason = "";

    readonly List<Col> _billCols = new() { new("Period", new[] { "periodStart" }, ColKind.Date), new("Amount", new[] { "totalAmount", "amount" }, ColKind.Money), new("Balance", new[] { "balance", "amountDue" }, ColKind.Money), new("Due", new[] { "dueDate" }, ColKind.Date), new("Status", new[] { "status" }, ColKind.Status) };
    readonly List<Col> _payCols = new() { new("Date", new[] { "paymentDate", "createdAt" }, ColKind.DateTime), new("Reference", new[] { "transactionRef", "transactionId", "reference" }, ColKind.Mono), new("Amount", new[] { "amountPaid", "amount" }, ColKind.Money), new("Method", new[] { "paymentMethod", "method" }) };
    readonly List<Col> _fineCols = new() { new("Applied", new[] { "appliedDate", "createdAt" }, ColKind.Date), new("Reason", new[] { "reason" }), new("Amount", new[] { "amount" }, ColKind.Money), new("Status", new[] { "status" }, ColKind.Status) };
    readonly List<Col> _contribCols = new() { new("Month", new[] { "contributionMonth" }, ColKind.Month), new("Required", new[] { "amountRequired" }, ColKind.Money), new("Paid", new[] { "amountPaid" }, ColKind.Money), new("Status", new[] { "status" }, ColKind.Status) };

    protected override async Task OnInitializedAsync()
    {
        var s = Api.Get(ApiRoutes.AccountSummary(CustomerId));
        var b = Api.Get(ApiRoutes.BillsForCustomer(CustomerId));
        var p = Api.Get(ApiRoutes.PaymentsForCustomer(CustomerId));
        var f = Api.Get(ApiRoutes.FinesForCustomer(CustomerId));
        var c = Api.Get(ApiRoutes.ContributionsForCustomer(CustomerId));
        await Task.WhenAll(s, b, p, f, c);
        _summary = s.Result.Item(); _bills = b.Result.Rows(); _pays = p.Result.Rows(); _fines = f.Result.Rows(); _contribs = c.Result.Rows();
        if (!s.Result.Success) Snack.Add(s.Result.Message ?? "Could not load account summary", Severity.Warning);
        _loading = false;
    }
    async Task Adjust()
    {
        if (_adj == 0) return;
        var r = await Api.Post(ApiRoutes.AdjustBalance(CustomerId), new { amount = _adj, reason = _reason });
        Snack.Add(r.Success ? "Balance adjusted" : r.Message ?? "Failed", r.Success ? Severity.Success : Severity.Error);
        if (r.Success) { _changed = true; _adj = 0; _reason = ""; _loading = true; await OnInitializedAsync(); }
    }
    async Task ToggleStatus() { var r = await Api.Post(ApiRoutes.ToggleStatus(CustomerId)); Snack.Add(r.Success ? "Status updated" : r.Message ?? "Failed", r.Success ? Severity.Success : Severity.Error); _changed |= r.Success; }
    async Task ResetPwd() { var r = await Api.Post(ApiRoutes.ResetPassword(CustomerId)); Snack.Add(r.Message ?? (r.Success ? "Password reset" : "Failed"), r.Success ? Severity.Success : Severity.Error); }
    void Close() => MudDialog.Close(DialogResult.Ok(_changed));
}
