@using MudBlazor
@inject ApiClient Api
@inject ISnackbar Snack
<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_cur" Label="Current password" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_new" Label="New password" InputType="InputType.Password" Variant="Variant.Outlined" />
        @if (_err is not null) { <MudAlert Severity="Severity.Error" Class="mt-3">@_err</MudAlert> }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy" OnClick="Submit">Update</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;
    string _cur = "", _new = "", _err; bool _busy;
    async Task Submit()
    {
        _busy = true; _err = null;
        var r = await Api.Post(ApiRoutes.AdminChangePassword, new { currentPassword = _cur, newPassword = _new });
        _busy = false;
        if (r.Success) { Snack.Add("Password updated", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); } else _err = r.Message;
    }
}
