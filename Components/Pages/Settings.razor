@page "/settings"
@attribute [Authorize(Roles = "admin,superadmin")]
@inject ApiClient Api
@inject PortalSession Session
@inject NavigationManager Nav
@inject ISnackbar Snack

<PageHeader Title="Settings" Subtitle="Scheme configuration and payment gateway">
    <MudButton Variant="Variant.Outlined" OnClick="Initialize">Initialize defaults</MudButton>
</PageHeader>

<MudTabs Elevation="0" Rounded="true" PanelClass="pt-3" @key="_reloadKey">
    <MudTabPanel Text="Company"><SettingsTab Category="company" /></MudTabPanel>
    <MudTabPanel Text="Billing"><SettingsTab Category="billing" /></MudTabPanel>
    <MudTabPanel Text="Payments"><SettingsTab Category="payments" /></MudTabPanel>
    <MudTabPanel Text="Contributions"><SettingsTab Category="contributions" /></MudTabPanel>
    <MudTabPanel Text="Notifications"><SettingsTab Category="notifications" /></MudTabPanel>
    <MudTabPanel Text="Equity biller">
        <MudPaper Elevation="0" Class="uf-card pa-4" Style="max-width:560px">
            <MudTextField @bind-Value="_user" Label="Biller username" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_pass" Label="Biller password" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_num" Label="Equity biller number" Variant="Variant.Outlined" Class="mb-3" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveEquity">Save credentials</MudButton>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    protected override void OnInitialized()
    {
        SchemeGuard.EnsureSchemeOrRedirect(Session, Nav, Snack);
    }

    string _user = "", _pass = "", _num = ""; int _reloadKey;
    async Task Initialize()
    {
        var r = await Api.Post(ApiRoutes.SettingsInitialize);
        Snack.Add(r.Success ? "Defaults initialized" : r.Message ?? "Failed", r.Success ? Severity.Success : Severity.Error);
        _reloadKey++;
    }
    async Task SaveEquity()
    {
        var r = await Api.Put(ApiRoutes.EquityCredentials, new { billerUsername = _user, billerPassword = _pass, equityBillerNumber = _num });
        Snack.Add(r.Success ? "Credentials saved" : r.Message ?? "Failed", r.Success ? Severity.Success : Severity.Error);
        if (r.Success) _pass = "";
    }
}